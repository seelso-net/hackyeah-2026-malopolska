{
  "name": "needs-platform-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Resident, moderator and doer app for the Needs-to-Solutions Platform (Ionic React + Capacitor)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript ${API_URL:-http://localhost:8080}/q/openapi -o src/api/schema.d.ts",
    "android": "npm run build && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@ionic/react": "^9.0.6",
    "@ionic/react-router": "^9.0.6",
    "@tanstack/react-query": "^5.104.1",
    "i18next": "^26.4.2",
    "ionicons": "^8.1.0",
    "leaflet": "^1.9.4",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-leaflet": "^5.0.0",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.2"
  }
}
